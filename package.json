{
  "name": "boxart-scraper-electron",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer.js --platform=browser --sourcemap --define:process.env.NODE_ENV='\"production\"' --format=iife",
    "build:main": "tsc -p tsconfig.json",
    "prepare-dist": "mkdir -p dist && cp public/index.html dist/index.html && cp public/style.css dist/style.css || true",
    "build": "npm run build:renderer && npm run build:main && npm run prepare-dist",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "esbuild": "^0.18.20",
    "typescript": "^5.5.6",
    "electron": "^26.2.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/node": "^20.5.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "jimp": "^0.16.1"
  }
}
